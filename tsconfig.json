{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    // The harness convention is a `.ts` extension on local relative imports.
    // Rewriting them on emit keeps that source style while the published
    // JavaScript and declarations still resolve `.js`.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
